# --- Required ---

# Postgres connection string (Vercel Postgres / Neon / Supabase / your own).
# Vercel Postgres or Neon: 1-click integrations on Vercel will populate this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 32 bytes base64. Generate with: openssl rand -base64 32
# Used to encrypt per-bequest hot wallet privkeys + sign auth/ping tokens.
MASTER_KEY=

# Public URL where this app is deployed. Used in magic-link emails and ping links.
APP_URL=https://your-app.vercel.app

# Zerion API key — used for token resolution + portfolio reads.
# Get one at https://developers.zerion.io
ZERION_API_KEY=

# Resend API key for email (magic links + nudges + delivery confirmation).
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Bequest <onboarding@resend.dev>"

# --- Vercel Cron auth ---
# Vercel injects the same value as `Authorization: Bearer ${CRON_SECRET}`.
# Generate any random string — must match the value Vercel uses.
CRON_SECRET=

# --- Telegram bot (optional but enabled in MVP) ---
# Create a bot with @BotFather, set this to its token. Set the bot username too
# (without @) so the link shown in the UI is correct.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BequestBot
# Random secret you give to Telegram when registering the webhook;
# Telegram will echo it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=

# --- Local dev convenience ---
# When 1 (or RESEND_API_KEY unset), emails are logged to console instead of sent.
# STUB_EMAIL=1
